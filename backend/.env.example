# Django Settings
DJANGO_SECRET_KEY="sua_chave_secreta_super_segura_aqui"
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1,api.receituario.edu.br"

# Database - Opção 1: Supabase (PostgreSQL Cloud Gratuito)
# Encontre no Supabase: Project Settings -> Database -> Connection string -> URI
DATABASE_URL="postgresql://postgres.seu-projeto:[SUA-SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Database - Opção 2: MySQL Local
DB_ENGINE=django.db.backends.mysql
DB_NAME=receituario_db
DB_USER=receituario_user
DB_PASSWORD=sua_senha_forte_do_mysql
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS & CSRF
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://receituario.edu.br"
CSRF_TRUSTED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://receituario.edu.br"

# Security & Cookies
JWT_SECRET_KEY="sua_chave_jwt_secreta_aqui"
JWT_COOKIE_SECURE=False  # Altere para True em produção com HTTPS
JWT_COOKIE_SAMESITE="Lax"
